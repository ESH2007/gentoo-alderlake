#!/bin/sh
# esh-theme — cambia el tema de todo el escritorio.
#   esh-theme            lista los temas
#   esh-theme <nombre>   aplica un tema (brasa, glaciar, musgo…)
# Temas: ~/.local/share/esh/themes/<nombre>/theme.env (+ wallpaper.png)
#        /usr/share/esh/themes/<nombre>/ (instalados por x11-themes/esh-tools)
set -eu

DATA_DIRS="${XDG_DATA_HOME:-$HOME/.local/share}/esh /usr/share/esh"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
OUT="$CONF/esh/current"

list() {
	for d in $DATA_DIRS; do
		for f in "$d"/themes/*/theme.env; do
			[ -e "$f" ] && basename "$(dirname "$f")"
		done
	done | sort -u
}

find_dir() { # find_dir <subruta>
	for d in $DATA_DIRS; do
		[ -e "$d/$1" ] && { echo "$d/$1"; return; }
	done
	return 1
}

if [ $# -eq 0 ]; then
	list
	exit 0
fi

name="$1"
tdir=$(find_dir "themes/$name") || { echo "Tema desconocido: $name" >&2; list >&2; exit 1; }
tpl=$(find_dir templates) || { echo "No encuentro las plantillas" >&2; exit 1; }

# Construye un script sed: {{CLAVE}} → #rrggbb y {{CLAVE_RAW}} → rrggbb
sedf=$(mktemp)
trap 'rm -f "$sedf"' EXIT
grep -E '^[A-Z0-9_]+=' "$tdir/theme.env" | while IFS='=' read -r k v; do
	raw=$(printf '%s' "$v" | tr -d '#')
	printf 's|{{%s}}|%s|g\ns|{{%s_RAW}}|%s|g\n' "$k" "$v" "$k" "$raw"
done > "$sedf"
printf 's|{{OUT}}|%s|g\n' "$OUT" >> "$sedf"

render() { mkdir -p "$(dirname "$2")"; sed -f "$sedf" "$tpl/$1" > "$2.tmp" && mv "$2.tmp" "$2"; }

mkdir -p "$OUT"
render sway.conf      "$OUT/sway.conf"
render swaylock.conf  "$CONF/swaylock/config"
render waybar.css     "$OUT/waybar.css"
render alacritty.toml "$OUT/alacritty.toml"
render mako.conf      "$CONF/mako/config"
render wofi.css       "$CONF/wofi/style.css"
ln -sf "$tdir/wallpaper.png" "$OUT/wallpaper"
echo "$name" > "$OUT/name"

# GTK claro/oscuro para apps como Firefox
mode=$(sed -n 's/^MODE=//p' "$tdir/theme.env")
if command -v gsettings >/dev/null 2>&1; then
	gsettings set org.gnome.desktop.interface color-scheme "prefer-$mode" 2>/dev/null || true
fi

# Recarga en caliente (si hay una sesión Sway activa). `swaymsg reload`
# vuelve a aplicar colores y fondo (output * bg).
if [ -n "${SWAYSOCK:-}" ]; then
	swaymsg reload >/dev/null
	pkill -SIGUSR2 -x waybar 2>/dev/null || true
	makoctl reload 2>/dev/null || true
	notify-send -a esh "Tema: $(sed -n 's/^NAME=//p' "$tdir/theme.env")" 2>/dev/null || true
fi
