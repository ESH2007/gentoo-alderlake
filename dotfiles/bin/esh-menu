#!/bin/sh
# esh-menu — menú rápido del sistema con wofi.
#   esh-menu [temas|energia|sistema|herramientas|servidor]
set -eu

pick() { # pick <título>  (opciones por stdin)
	wofi --dmenu --insensitive --prompt "$1" --width 420 --height 320 --cache-file /dev/null
}

term() { setsid -f alacritty --class esh-float --hold -e "$@" >/dev/null 2>&1; }

temas() {
	actual=$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/esh/current/name" 2>/dev/null || echo)
	t=$(esh-theme | sed "s/^$actual\$/$actual  (actual)/" | pick "Tema") || exit 0
	esh-theme "${t%% *}"
}

energia() {
	estado=$(cat /sys/firmware/acpi/platform_profile 2>/dev/null || echo "?")
	o=$(printf '%s\n' \
		"Automático (según cargador)" \
		"Rendimiento" \
		"Ahorro de batería" \
		"Informe de consumo (powertop)" | pick "Energía · perfil: $estado") || exit 0
	case "$o" in
		Auto*)        pkexec tlp start ;;
		Rend*)        pkexec tlp ac ;;
		Ahorro*)      pkexec tlp bat ;;
		Informe*)     term sudo powertop ;;
	esac
	notify-send -a esh "Energía" "$o" 2>/dev/null || true
}

sistema() {
	o=$(printf '%s\n' "Bloquear" "Suspender" "Cerrar sesión" "Reiniciar" "Apagar" | pick "Sistema") || exit 0
	case "$o" in
		Bloquear)    loginctl lock-session ;;
		Suspender)   systemctl suspend ;;
		Cerrar*)     swaymsg exit ;;
		Reiniciar)   systemctl reboot ;;
		Apagar)      systemctl poweroff ;;
	esac
}

herramientas() {
	o=$(printf '%s\n' \
		"Actualizar el sistema" \
		"Limpiar paquetes huérfanos" \
		"Wi‑Fi (iwctl)" \
		"Audio (pulsemixer)" \
		"Monitor del sistema (btop)" \
		"Tiempo de arranque" | pick "Herramientas") || exit 0
	case "$o" in
		Actualizar*) term sh -c 'sudo emerge --sync && sudo emerge -avuDN @world' ;;
		Limpiar*)    term sudo emerge -a --depclean ;;
		Wi*)         term iwctl ;;
		Audio*)      setsid -f alacritty --class esh-float -e pulsemixer ;;
		Monitor*)    setsid -f alacritty --class esh-float -e btop ;;
		Tiempo*)     term sh -c 'systemd-analyze; systemd-analyze blame | head -15' ;;
	esac
}

# Servidor de compilación (CachyOS). El alias "build" vive en ~/.ssh/config
# (ver docs/REMOTE.md). Cambia ESH_SERVER si lo llamas de otra forma.
servidor() {
	srv="${ESH_SERVER:-build}"
	o=$(printf '%s\n' \
		"Terminal en el servidor (tmux)" \
		"Escritorio remoto (Remmina)" \
		"Streaming fluido (Moonlight)" \
		"Montar carpetas del servidor (~/servidor)" \
		"Estado de Tailscale" | pick "Servidor · $srv") || exit 0
	case "$o" in
		# tmux new -A: se reengancha a la sesión "main" si ya existe, así una
		# compilación larga sigue viva aunque se corte el Wi‑Fi.
		Terminal*)   setsid -f alacritty --title "$srv" -e ssh -t "$srv" 'tmux new -A -s main' >/dev/null 2>&1 ;;
		Escritorio*) setsid -f remmina >/dev/null 2>&1 ;;
		Streaming*)  command -v moonlight >/dev/null && setsid -f moonlight >/dev/null 2>&1 \
		                 || notify-send -a esh "Moonlight no instalado" "Activa USE=stream en app-misc/esh-desktop" ;;
		Montar*)     mkdir -p "$HOME/servidor"
		             if mountpoint -q "$HOME/servidor"; then
		                 fusermount3 -u "$HOME/servidor" && notify-send -a esh "Servidor" "Desmontado ~/servidor"
		             else
		                 sshfs "$srv:" "$HOME/servidor" -o reconnect,ServerAliveInterval=15 \
		                     && notify-send -a esh "Servidor" "Montado en ~/servidor" \
		                     || notify-send -a esh "Servidor" "No pude montar (¿ssh $srv funciona?)"
		             fi ;;
		Estado*)     term tailscale status ;;
	esac
}

case "${1:-}" in
	servidor)     servidor ;;
	temas)        temas ;;
	energia)      energia ;;
	sistema)      sistema ;;
	herramientas) herramientas ;;
	*)
		o=$(printf '%s\n' "Aplicaciones" "Temas" "Energía" "Herramientas" "Servidor" "Atajos de teclado" "Sistema" | pick "ESH") || exit 0
		case "$o" in
			Aplic*)  wofi --show drun ;;
			Temas)   temas ;;
			Ener*)   energia ;;
			Herr*)   herramientas ;;
			Serv*)   servidor ;;
			Atajos*) esh-keys ;;
			Sistema) sistema ;;
		esac ;;
esac
