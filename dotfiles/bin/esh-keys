#!/bin/sh
# esh-keys — muestra los atajos de Sway en una lista buscable.
# Lee las líneas "## Descripción" que van encima de cada bindsym/bindgesture
# en ~/.config/sway/config y local.conf.
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/sway"
cat "$CONF/config" "$CONF/local.conf" 2>/dev/null | awk '
	/^[[:space:]]*## / { d = $0; sub(/^[[:space:]]*## /, "", d); next }
	/^[[:space:]]*bind(sym|gesture)/ && d != "" {
		k = ""
		for (i = 2; i <= NF; i++) if ($i !~ /^--/) { k = $i; break }
		gsub(/\$mod/, "SUPER", k); gsub(/Mod1/, "ALT", k); gsub(/Mod4/, "SUPER", k)
		gsub(/\+/, " + ", k)
		k = toupper(k)
		if (k ~ /^SUPER \+ 1$/) k = "SUPER + 1…9"
		if (k ~ /^SUPER \+ SHIFT \+ 1$/) k = "SUPER + SHIFT + 1…9"
		if (k ~ /^SWIPE:3:/) k = "3 DEDOS ← →"
		printf "%-28s %s\n", k, d
		d = ""; next
	}
	{ d = "" }' |
	wofi --dmenu --insensitive --prompt "Atajos" --width 640 --height 520 --cache-file /dev/null >/dev/null
