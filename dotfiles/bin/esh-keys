#!/bin/sh
# esh-keys — muestra los atajos (los `bindd` de hyprland.conf) en una lista buscable.
hyprctl binds -j | jq -r '
	def mods: [
		(if . % 2 >= 1 then "SHIFT" else empty end),
		(if (. / 4 | floor) % 2 == 1 then "CTRL" else empty end),
		(if (. / 8 | floor) % 2 == 1 then "ALT" else empty end),
		(if (. / 64 | floor) % 2 == 1 then "SUPER" else empty end)
	] | reverse | join(" + ");
	.[] | select(.has_description) |
	((.modmask | mods) as $m |
	 (if $m == "" then .key else "\($m) + \(.key)" end) | ascii_upcase) as $k |
	"\($k)\t\(.description)"' |
	awk -F'\t' '{ printf "%-28s %s\n", $1, $2 }' |
	wofi --dmenu --insensitive --prompt "Atajos" --width 640 --height 520 --cache-file /dev/null >/dev/null
