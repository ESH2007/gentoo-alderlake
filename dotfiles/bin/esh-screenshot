#!/bin/sh
# esh-screenshot [zona|pantalla|ventana] — guarda en ~/Imágenes/Capturas y copia al portapapeles
set -eu
dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Imágenes")/Capturas"
mkdir -p "$dir"
f="$dir/captura-$(date +%Y%m%d-%H%M%S).png"

case "${1:-zona}" in
	zona)     geo=$(slurp) || exit 0; grim -g "$geo" "$f" ;;
	ventana)  geo=$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"'); grim -g "$geo" "$f" ;;
	pantalla) grim "$f" ;;
esac

wl-copy < "$f"
notify-send -a esh -i "$f" "Captura guardada" "$(basename "$f") · copiada al portapapeles" 2>/dev/null || true
