#!/bin/sh
# esh-blur — activa/desactiva blur y sombras (más bonito vs. más batería)
if [ "$(hyprctl getoption decoration:blur:enabled -j | jq .int)" = 1 ]; then
	hyprctl --batch "keyword decoration:blur:enabled 0; keyword decoration:shadow:enabled 0; keyword decoration:active_opacity 1; keyword decoration:inactive_opacity 1" >/dev/null
	notify-send -a esh "Efectos desactivados" "Modo ahorro" 2>/dev/null || true
else
	hyprctl --batch "keyword decoration:blur:enabled 1; keyword decoration:shadow:enabled 1; keyword decoration:inactive_opacity 0.92" >/dev/null
	notify-send -a esh "Efectos activados" "Blur y sombras" 2>/dev/null || true
fi
