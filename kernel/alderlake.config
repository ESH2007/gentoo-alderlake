# Fragmento de configuración para HP con Core i3 12.ª gen (Alder Lake).
# Se aplica ENCIMA de un .config creado con `make localmodconfig`:
#   scripts/kconfig/merge_config.sh -m .config /opt/gentoo-alderlake/kernel/alderlake.config
#   make olddefconfig
# Ver docs/KERNEL.md

# --- CPU y planificador ------------------------------------------------------
CONFIG_SCHED_MC=y
CONFIG_SCHED_CLUSTER=y
CONFIG_SCHED_MC_PRIO=y
# Intel Thread Director (núcleos P/E): HFI le dice al planificador qué núcleo usar
CONFIG_INTEL_HFI_THERMAL=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y

# --- Energía -----------------------------------------------------------------
# intel_pstate en modo activo + HWP: el hardware ajusta la frecuencia según EPP
CONFIG_CPU_FREQ=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_POWERSAVE=y
CONFIG_INTEL_IDLE=y
CONFIG_INTEL_RAPL=m
CONFIG_POWERCAP=y
CONFIG_INTEL_TCC_COOLING=m
CONFIG_X86_PKG_TEMP_THERMAL=m
CONFIG_INT340X_THERMAL=m
CONFIG_ACPI_PLATFORM_PROFILE=y
CONFIG_HP_WMI=m
CONFIG_PCIEASPM=y
CONFIG_PCIEASPM_POWER_SUPERSAVE=y
CONFIG_SATA_MOBILE_LPM_POLICY=3
CONFIG_PM_AUTOSLEEP=n
CONFIG_SUSPEND=y
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y

# --- Memoria (8 GB) ----------------------------------------------------------
# MGLRU: mejor reclamo de memoria bajo presión
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# zram con zstd (zswap queda compilado pero desactivado: usamos zram)
CONFIG_ZRAM=m
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_LZ4=m
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=n

# --- Arranque sin initramfs -------------------------------------------------
# NVMe, ext4 y vfat dentro del kernel para montar / sin initramfs
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_EFIVAR_FS=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_KERNEL_ZSTD=y
CONFIG_MODULE_COMPRESS_ZSTD=y

# --- Requisitos de systemd ---------------------------------------------------
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_FANOTIFY=y
CONFIG_AUTOFS_FS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_DMIID=y
CONFIG_PSI=y
CONFIG_BPF_SYSCALL=y

# --- Gráficos Intel Xe (iGPU de Alder Lake) ---------------------------------
# i915 como módulo: así carga el firmware (GuC/HuC/DMC) desde /lib/firmware
CONFIG_DRM=y
CONFIG_DRM_I915=m
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y

# --- Portátil: touchpad I2C, teclas, retroiluminación -----------------------
CONFIG_PINCTRL_ALDERLAKE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=m
CONFIG_I2C_HID_ACPI=m
CONFIG_HID_MULTITOUCH=m
CONFIG_MFD_INTEL_LPSS_PCI=m
CONFIG_ACPI_VIDEO=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_INPUT_UINPUT=m

# --- Audio (SOF: Sound Open Firmware, típico en Alder Lake) -----------------
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_ALDERLAKE=m
CONFIG_SND_HDA_POWER_SAVE_DEFAULT=1

# --- Seguridad básica y depuración fuera -----------------------------------
CONFIG_SECURITY_LANDLOCK=y
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_KERNEL=n
CONFIG_SLUB_DEBUG=n
CONFIG_FTRACE=n
CONFIG_KPROBES=n

# --- Cifrado que necesita iwd (Wi‑Fi) -----------------------------------------
# Sin esto iwd no arranca (p. ej. el kernel precompilado gentoo-dist no trae DES).
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_DES3_EDE_X86_64=y
CONFIG_CRYPTO_MD4=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_RSA=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y
CONFIG_RFKILL=y

# --- Pantalla desde el primer segundo --------------------------------------------
# Muestra los mensajes de arranque (y cualquier error) antes de que cargue i915.
CONFIG_VT=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# --- VPN (Tailscale/WireGuard) y cortafuegos nftables ----------------------------
CONFIG_TUN=y
CONFIG_WIREGUARD=m
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_MANGLE=y
