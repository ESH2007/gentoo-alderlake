#!/bin/sh
# /usr/local/bin/esh-session — lo lanza greetd. Carga el perfil (PATH con
# ~/.local/bin para los scripts esh-*) y arranca Hyprland.
[ -r /etc/profile ] && . /etc/profile
[ -r "$HOME/.profile" ] && . "$HOME/.profile"
export XDG_CURRENT_DESKTOP=Hyprland XDG_SESSION_DESKTOP=Hyprland
exec Hyprland
