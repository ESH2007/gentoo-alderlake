#!/bin/sh
# /usr/local/bin/esh-session — lo lanza greetd. Carga el perfil (PATH con
# ~/.local/bin para los scripts esh-*) y arranca Sway.
[ -r /etc/profile ] && . /etc/profile
[ -r "$HOME/.profile" ] && . "$HOME/.profile"
export XDG_CURRENT_DESKTOP=sway XDG_SESSION_DESKTOP=sway XDG_SESSION_TYPE=wayland
export MOZ_ENABLE_WAYLAND=1 QT_QPA_PLATFORM="wayland;xcb" LIBVA_DRIVER_NAME=iHD
export XCURSOR_THEME=Adwaita XCURSOR_SIZE=24
exec sway
